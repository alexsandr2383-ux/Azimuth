#
# Azimuth enduro profile.
#
# Close to "shortest by distance": tracks and minor roads are preferred,
# foot/bridle paths are allowed with a moderate penalty (the app marks them
# as "TRAIL (not a road)"), steps and alpine trails are excluded.
# Explicit legal bans for motor vehicles are penalised, not forbidden:
# the app warns about them instead.
#

---context:global

assign downhillcost 0
assign downhillcutoff 0
assign uphillcost 0
assign uphillcutoff 0

assign validForFoot  1
assign validForBikes 1
assign validForCars  1

assign turnInstructionMode = 0

---context:way

assign turncost = if junction=roundabout then 0 else 20

assign initialclassifier = if route=ferry then 1 else 0
assign initialcost = if route=ferry then 20000 else 0

assign istrail = highway=path|footway|bridleway|pedestrian|cycleway

assign isunrideable =
  or highway=steps|via_ferrata|platform|elevator|corridor|construction|proposed|abandoned|raceway
  or sac_scale=demanding_mountain_hiking|alpine_hiking|demanding_alpine_hiking|difficult_alpine_hiking
  or mtb:scale=4|5
     trail_visibility=bad|horrible|no

assign motorforbidden =
  switch motorcycle=
    switch motor_vehicle=
      switch vehicle=
        access=no|private
        vehicle=no|private
      motor_vehicle=no|private|agricultural
    motorcycle=no|private

assign restrictpenalty =
  if motorforbidden then ( if access=private then 4 else 0.5 ) else 0

assign onewaypenalty =
  switch istrail 0
  switch switch reversedirection=yes
                switch oneway=
                       junction=roundabout
                       or oneway=yes or oneway=true oneway=1
                oneway=-1
         10000
         0

assign roadfactor =
  switch highway=motorway|motorway_link|trunk|trunk_link 10000
  switch highway=primary|primary_link 1.5
  switch highway=secondary|secondary_link 1.3
  switch highway=tertiary|tertiary_link 1.15
  switch highway=unclassified|road 1.05
  switch highway=residential|living_street|service 1.2
  switch highway=track 1.0
  switch istrail ( if sac_scale=mountain_hiking then 3 else 1.6 )
  switch route=ferry 5.67
  10000

assign costfactor =
  if isunrideable then 10000
  else add roadfactor add restrictpenalty onewaypenalty

assign priorityclassifier = 0
assign classifiermask = 0

# Expose these tags in the route's WayTags so the app can flag trails, bans and fords.
assign dummyUsage1 = ford=
assign dummyUsage2 = surface=
assign dummyUsage3 = tracktype=
assign dummyUsage4 = smoothness=

---context:node

assign initialcost =
  switch barrier=stile|turnstile|kissing_gate|block 1000000
  switch barrier=bollard|cycle_barrier 200
  0
